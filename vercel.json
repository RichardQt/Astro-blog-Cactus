{
    "crons": [
        {
            "path": "/cron-update-feeds?secret=${CRON_SECRET}",
            "schedule": "0 0 * * *"
        }
    ],
    "headers": [
        {
            "source": "/pagefind/pagefind-entry.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=300, must-revalidate"
                }
            ]
        },
        {
            "source": "/pagefind/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/icons/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(rss\\.xml|notes/rss\\.xml)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, stale-while-revalidate=86400"
                }
            ]
        }
    ]
}
