# Upstash Redis Configuration (推荐 - 更多免费额度)
# 从Upstash Dashboard获取: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV Configuration (可选 - 免费额度较少)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# CRON Secret for securing scheduled tasks
CRON_SECRET=your-secret-key-here

# Site URL (for API calls)
SITE=https://your-domain.vercel.app

# Optional: Function region (for better performance)
VERCEL_REGION=iad1

# Obsidian vault root (local only, used by npm run sync:obsidian)
# 发布区：<vault>/博客发布/博客 → src/content/post
#         <vault>/博客发布/随记 → src/content/note
#         <vault>/博客发布/草稿 不同步
# OBSIDIAN_VAULT=D:\Obsidan_project\richardli-brain
